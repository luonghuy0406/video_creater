    "@remotion/renderer": "^4.0.230",
    "@remotion/three": "^4.0.230",
    "postprocessing": "^6.35.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.230",
    "three": "^0.166.1",
    "three-stdlib": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.1",
